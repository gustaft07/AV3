# Copie para .env e ajuste
# Usuário root em desenvolvimento: o "prisma migrate dev" precisa criar/apagar um banco temporário (shadow database).
DATABASE_URL="mysql://root:greencode@localhost:3306/greencode"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
PORT=3000

REDIS_URL="redis://127.0.0.1:6379"          # com o docker-compose do projeto: redis://localhost:6379
STORAGE_DIR="./storage"                     # onde o worker grava os relatórios (API e worker precisam enxergar a mesma pasta)
PUBLIC_BASE_URL="http://localhost:3000"     # usado nos links enviados por webhook
WORKER_CONCURRENCY=2                        # relatórios processados em paralelo por worker
RELATORIO_TTL_DIAS=7                        # validade do arquivo do relatório
MAX_TAREFAS_PENDENTES_POR_ORG=5             # tarefas simultâneas por organização/parceiro
RATE_LIMIT_PADRAO_POR_MIN=60                # limite de requisições/min para chaves sem limite próprio
SCHEDULER_ENABLED=true                      # registra os agendamentos ao iniciar o worker
TZ_AGENDAMENTO="America/Sao_Paulo"
